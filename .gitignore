# CrispyTheme - Development .gitignore

# Dependencies
/vendor/
/node_modules/

# Build artifacts
/build/

# Generated outputs (distribution zips, staging) — never committed
/output/
/temp/

# Generated knowledge graph (large, AST-derived; rebuild with `graphify update .`)
/graphify-out/

# opencode local tool state
/.opencode/

# Composer
composer.lock

# npm
package-lock.json

# IDE and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
/coverage/
.phpunit.result.cache
.pest.cache

# PHPStan
phpstan-baseline.neon

# Environment
.env
.env.local
.env.*.local

# WordPress test environment
/tests/wordpress/
/tests/wordpress-tests-lib/
/tmp/

# Cache directories
.cache/
.php-cs-fixer.cache
.deptrac.cache

# Deployment artifacts
*.zip

# Tool configurations
.claude/
.serena/

# Local development
local-*.php
*.local.php

# Captured copies of the live site (hold third-party key strings). Kept on disk, never tracked (Penn, 2026-11-19).
/input/livehtml.htm
/input/www.christopherspenn.com.har

# Personal photographs and internal research: never published (Penn, 2026-11-20). The repo is public.
/input/
/docs/CSP ICP.txt
/docs/CSP About.txt

# PHPUnit and Pest cache
/.phpunit.cache/
